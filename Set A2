<!DOCTYPE html>
<html>
<head>
    <title>Car Object</title>
</head>

<body>

<script>
    let car = {
        brand: "Toyota",
        model: "Fortuner",
        year: 2024,

        displayDetails: function() {
            console.log("Brand: " + this.brand);
            console.log("Model: " + this.model);
            console.log("Year: " + this.year);
        }
    };

    car.displayDetails();
</script>

</body>
</html>
