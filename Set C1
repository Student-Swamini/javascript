<!DOCTYPE html>
<html>
<head>
    <title>Factorial</title>
</head>
<body>

<script>
    function findFactorial() {
        let num = parseInt(prompt("Enter a number:"));
        let factorial = 1;

        if (isNaN(num) || num < 0) {
            alert("Please enter a valid positive number.");
            return;
        }

        for (let i = 1; i <= num; i++) {
            factorial = factorial * i;
        }

        alert("Factorial of " + num + " is " + factorial);
    }

    findFactorial();
</script>

</body>
</
